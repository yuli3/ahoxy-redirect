---
const canonical = "https://ahoxy.com/ko/kbd/";
const title = "로스트아크 아재패턴 연습 — QWERASDF 키보드 게임";
const description = "QWERASDF 8개 키로 로스트아크 아재패턴을 연습하세요. 4~8키 랜덤 패턴, 제한시간, 연승과 최고기록을 브라우저에 저장합니다.";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: "로스트아크 아재패턴 연습",
      url: canonical,
      description,
      applicationCategory: "GameApplication",
      operatingSystem: "Any",
      browserRequirements: "JavaScript",
      offers: { "@type": "Offer", price: "0", priceCurrency: "KRW" },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Ahoxy", item: "https://ahoxy.com/" },
        { "@type": "ListItem", position: 2, name: "아재패턴 연습", item: canonical },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #080b14;
        --panel: #111827;
        --panel-2: #172033;
        --line: #2b3852;
        --text: #f8fafc;
        --muted: #a8b3c7;
        --accent: #f5b942;
        --accent-2: #ff7a45;
        --good: #45d483;
        --bad: #ff667a;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(circle at 50% -10%, rgba(245, 185, 66, .2), transparent 32rem),
          linear-gradient(180deg, #0b1020 0%, var(--bg) 55%);
        color: var(--text);
        font-family: Pretendard, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans KR", sans-serif;
      }
      a { color: #ffd77d; }
      button { font: inherit; }
      .shell { width: min(940px, calc(100% - 32px)); margin: 0 auto; padding: 28px 0 64px; }
      .eyebrow { margin: 0 0 10px; color: var(--accent); font-size: 13px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
      h1 { margin: 0; max-width: 760px; font-size: clamp(30px, 6vw, 54px); line-height: 1.08; letter-spacing: -.045em; }
      .lead { max-width: 680px; margin: 16px 0 28px; color: var(--muted); font-size: 17px; line-height: 1.7; }
      .game {
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 24px;
        background: rgba(17, 24, 39, .92);
        box-shadow: 0 28px 80px rgba(0, 0, 0, .38);
      }
      .game-head { display: flex; justify-content: space-between; gap: 16px; padding: 18px 22px; border-bottom: 1px solid var(--line); }
      .status { font-weight: 800; }
      .level { color: var(--muted); font-size: 14px; }
      .arena { min-height: 360px; display: grid; align-content: center; gap: 24px; padding: 34px 20px; text-align: center; }
      .message { min-height: 30px; margin: 0; color: var(--muted); font-weight: 700; }
      .pattern { display: flex; flex-wrap: wrap; justify-content: center; gap: clamp(7px, 2vw, 13px); min-height: 70px; }
      .key {
        width: clamp(48px, 11vw, 68px); height: clamp(54px, 12vw, 74px);
        display: grid; place-items: center;
        border: 1px solid #43516b; border-bottom-width: 5px; border-radius: 13px;
        background: linear-gradient(180deg, #26334a, #182236);
        color: white; font-size: clamp(22px, 5vw, 31px); font-weight: 900;
      }
      .key.done { border-color: #2c9e61; background: #174b35; color: #a7f3d0; transform: translateY(3px); border-bottom-width: 2px; }
      .timer { width: min(620px, 100%); height: 9px; margin: 0 auto; overflow: hidden; border-radius: 999px; background: #28344a; }
      .timer > span { display: block; width: 100%; height: 100%; transform-origin: left; background: linear-gradient(90deg, var(--accent), var(--accent-2)); }
      .controls { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
      .btn { min-height: 46px; padding: 0 22px; border: 1px solid transparent; border-radius: 999px; cursor: pointer; font-weight: 900; }
      .btn-primary { background: var(--accent); color: #1d1606; }
      .btn-secondary { border-color: var(--line); background: #1c273a; color: var(--text); }
      .btn:focus-visible, .mobile-key:focus-visible, a:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
      .mobile-keys { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
      .mobile-key { width: 48px; height: 48px; border: 1px solid #52617b; border-radius: 10px; background: #202c41; color: white; cursor: pointer; font-weight: 900; }
      .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; border-top: 1px solid var(--line); background: var(--line); }
      .stat { padding: 18px 10px; background: var(--panel); text-align: center; }
      .stat strong { display: block; margin-top: 4px; font-size: 22px; }
      .stat span { color: var(--muted); font-size: 12px; }
      .content { display: grid; grid-template-columns: 1.2fr .8fr; gap: 18px; margin-top: 22px; }
      .card { padding: 24px; border: 1px solid var(--line); border-radius: 18px; background: rgba(17, 24, 39, .72); }
      .card h2 { margin: 0 0 12px; font-size: 21px; }
      .card p, .card li { color: var(--muted); line-height: 1.75; }
      .card ol, .card ul { margin-bottom: 0; padding-left: 22px; }
      .reset { margin-top: 16px; border: 0; background: none; color: var(--muted); cursor: pointer; text-decoration: underline; }
      footer { margin-top: 24px; color: #7f8ba1; font-size: 12px; line-height: 1.7; }
      [data-tone="good"] { color: var(--good); }
      [data-tone="bad"] { color: var(--bad); }
      @media (max-width: 680px) {
        .stats { grid-template-columns: repeat(2, 1fr); }
        .content { grid-template-columns: 1fr; }
        .arena { min-height: 390px; padding-inline: 12px; }
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; animation: none !important; }
      }
    </style>
  </head>
  <body>
    <main class="shell">
      <p class="eyebrow">Lost Ark pattern practice</p>
      <h1>아재패턴, 손이 먼저 기억하게.</h1>
      <p class="lead">화면에 나타난 QWERASDF 패턴을 제한시간 안에 순서대로 입력하세요. 짧게 시작해 8키까지 올라가며 정확도와 최고 연승을 기록합니다.</p>

      <section class="game" aria-labelledby="game-title">
        <div class="game-head">
          <strong id="game-title">QWERASDF 패턴 훈련</strong>
          <span class="level" id="level">대기 중</span>
        </div>
        <div class="arena" id="arena" tabindex="-1">
          <p class="message" id="message" aria-live="polite">시작하면 4~8개의 키 패턴이 나타납니다.</p>
          <div class="pattern" id="pattern" aria-label="입력할 키 패턴"></div>
          <div class="timer" aria-label="남은 시간"><span id="timer-bar"></span></div>
          <div class="controls">
            <button class="btn btn-primary" id="start" type="button">게임 시작</button>
            <button class="btn btn-secondary" id="stop" type="button" hidden>그만하기</button>
          </div>
          <div class="mobile-keys" aria-label="화면 키보드">
            {['Q', 'W', 'E', 'R', 'A', 'S', 'D', 'F'].map((key) => <button class="mobile-key" type="button" data-key={key}>{key}</button>)}
          </div>
        </div>
        <div class="stats" aria-label="게임 통계">
          <div class="stat"><span>성공률</span><strong id="accuracy">—</strong></div>
          <div class="stat"><span>현재 / 최고 연승</span><strong id="streak">0 / 0</strong></div>
          <div class="stat"><span>평균 완료</span><strong id="average">—</strong></div>
          <div class="stat"><span>최고 기록</span><strong id="best">—</strong></div>
        </div>
      </section>

      <div class="content">
        <section class="card">
          <h2>게임 방법</h2>
          <ol>
            <li>게임 시작을 누르고 표시된 키를 왼쪽부터 입력합니다.</li>
            <li>4키는 4초, 키가 하나 늘 때마다 0.5초가 추가됩니다.</li>
            <li>틀리거나 시간이 끝나면 새 패턴으로 다시 시작합니다.</li>
            <li>속도보다 정확도를 먼저 높인 뒤 연승 기록에 도전하세요.</li>
          </ol>
          <p><strong>기록 해석:</strong> 성공률이 70% 미만이면 천천히 순서를 읽는 연습부터, 70~90%면 6~8키 연승을, 90% 이상이면 평균 완료시간 단축을 목표로 삼아보세요. 이 수치는 훈련용 안내이며 능력 진단 기준이 아닙니다.</p>
        </section>
        <aside class="card">
          <h2>기록은 내 기기에만</h2>
          <p>플레이 통계는 서버나 데이터베이스로 전송하지 않고 현재 브라우저에만 저장합니다.</p>
          <p><a href="https://game.oiyo.net/ko/lostark-raid-distribution?utm_source=ahoxy&utm_medium=related&utm_campaign=kbd">로스트아크 레이드 분배 계산기 →</a></p>
          <button class="reset" id="reset" type="button">저장된 기록 초기화</button>
        </aside>
      </div>

      <footer>
        이 페이지는 로스트아크 및 관련 상표권자와 무관한 비공식 팬 연습 도구입니다. 실제 게임의 패턴·난이도·입력 환경과 차이가 있을 수 있습니다.
      </footer>
    </main>

    <script>
      const KEYS = ['Q', 'W', 'E', 'R', 'A', 'S', 'D', 'F'];
      const STORAGE_KEY = 'ahoxy-kbd-stats-v1';
      const emptyStats = () => ({ plays: 0, wins: 0, streak: 0, maxStreak: 0, totalMs: 0, bestMs: 0 });
      const loadStats = () => {
        try { return { ...emptyStats(), ...JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}') }; }
        catch { return emptyStats(); }
      };
      let stats = loadStats();
      let active = false;
      let pattern = [];
      let cursor = 0;
      let startedAt = 0;
      let deadline = 0;
      let frame = 0;
      let nextRoundTimer = 0;

      const message = document.querySelector('#message');
      const patternEl = document.querySelector('#pattern');
      const timerBar = document.querySelector('#timer-bar');
      const level = document.querySelector('#level');
      const startButton = document.querySelector('#start');
      const stopButton = document.querySelector('#stop');
      const arena = document.querySelector('#arena');

      function saveStats() {
        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(stats)); }
        catch { /* 저장이 차단돼도 현재 세션의 게임과 통계는 계속한다. */ }
        renderStats();
      }
      function renderStats() {
        const accuracy = stats.plays ? Math.round((stats.wins / stats.plays) * 100) + '%' : '—';
        const average = stats.wins ? Math.round(stats.totalMs / stats.wins) + 'ms' : '—';
        document.querySelector('#accuracy').textContent = accuracy;
        document.querySelector('#streak').textContent = `${stats.streak} / ${stats.maxStreak}`;
        document.querySelector('#average').textContent = average;
        document.querySelector('#best').textContent = stats.bestMs ? stats.bestMs + 'ms' : '—';
      }
      function makePattern(length) {
        return Array.from({ length }, () => KEYS[Math.floor(Math.random() * KEYS.length)]);
      }
      function renderPattern() {
        patternEl.replaceChildren(...pattern.map((key, index) => {
          const node = document.createElement('span');
          node.className = 'key' + (index < cursor ? ' done' : '');
          node.textContent = key;
          node.setAttribute('aria-label', `${index + 1}번째 키 ${key}${index < cursor ? ', 입력 완료' : ''}`);
          return node;
        }));
      }
      function updateTimer(now) {
        if (!active) return;
        const total = deadline - startedAt;
        const remaining = Math.max(0, deadline - now);
        timerBar.style.transform = `scaleX(${remaining / total})`;
        if (remaining <= 0) return finish(false, '시간 초과! 새 패턴으로 다시 갑니다.');
        frame = requestAnimationFrame(updateTimer);
      }
      function beginRound(length = Math.floor(Math.random() * 5) + 4) {
        clearTimeout(nextRoundTimer);
        cancelAnimationFrame(frame);
        pattern = makePattern(length);
        cursor = 0;
        active = true;
        const limit = 4000 + (length - 4) * 500;
        startedAt = performance.now();
        deadline = startedAt + limit;
        level.textContent = `${length}키 · ${(limit / 1000).toFixed(1)}초`;
        message.textContent = '패턴을 순서대로 입력하세요.';
        message.dataset.tone = '';
        renderPattern();
        if (document.activeElement === startButton) arena.focus({ preventScroll: true });
        frame = requestAnimationFrame(updateTimer);
      }
      function finish(success, copy) {
        if (!active) return;
        active = false;
        cancelAnimationFrame(frame);
        stats.plays += 1;
        if (success) {
          const elapsed = Math.round(performance.now() - startedAt);
          stats.wins += 1;
          stats.streak += 1;
          stats.maxStreak = Math.max(stats.maxStreak, stats.streak);
          stats.totalMs += elapsed;
          stats.bestMs = stats.bestMs ? Math.min(stats.bestMs, elapsed) : elapsed;
          message.textContent = `성공! ${elapsed}ms · 다음 패턴을 준비합니다.`;
          message.dataset.tone = 'good';
        } else {
          stats.streak = 0;
          message.textContent = copy;
          message.dataset.tone = 'bad';
        }
        saveStats();
        timerBar.style.transform = 'scaleX(0)';
        nextRoundTimer = window.setTimeout(() => beginRound(success ? undefined : pattern.length), 850);
      }
      function inputKey(rawKey) {
        if (!active) return;
        const key = rawKey.toUpperCase();
        if (!KEYS.includes(key)) return;
        if (key !== pattern[cursor]) return finish(false, `${key}가 아니라 ${pattern[cursor]} 차례입니다. 새 패턴으로 다시 갑니다.`);
        cursor += 1;
        renderPattern();
        if (cursor === pattern.length) finish(true, '');
      }
      function stopGame() {
        active = false;
        clearTimeout(nextRoundTimer);
        cancelAnimationFrame(frame);
        pattern = [];
        cursor = 0;
        renderPattern();
        timerBar.style.transform = 'scaleX(1)';
        message.textContent = '게임을 멈췄습니다. 다시 시작할 수 있습니다.';
        message.dataset.tone = '';
        level.textContent = '대기 중';
        startButton.hidden = false;
        stopButton.hidden = true;
      }
      startButton.addEventListener('click', () => {
        startButton.hidden = true;
        stopButton.hidden = false;
        beginRound();
      });
      stopButton.addEventListener('click', stopGame);
      document.addEventListener('keydown', (event) => {
        if (event.repeat || event.metaKey || event.ctrlKey || event.altKey) return;
        if (active && KEYS.includes(event.key.toUpperCase())) event.preventDefault();
        inputKey(event.key);
      });
      document.querySelectorAll('[data-key]').forEach((button) => button.addEventListener('click', () => inputKey(button.dataset.key || '')));
      document.querySelector('#reset').addEventListener('click', () => {
        stats = emptyStats();
        try { localStorage.removeItem(STORAGE_KEY); }
        catch { /* 저장소 접근이 차단된 환경에서도 메모리 통계는 초기화한다. */ }
        renderStats();
        message.textContent = '저장된 기록을 초기화했습니다.';
        message.dataset.tone = '';
      });
      renderStats();
    </script>
  </body>
</html>
